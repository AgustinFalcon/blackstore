{
  "name": "blackstore-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --port 4201",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "lint": "ng lint",
    "test:dct": "playwright test --config playwright.dct.config.ts",
    "typecheck:dct": "tsc --noEmit -p tsconfig.dct.json",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:demo:domain": "node e2e/demo/unit-runner.cjs"
  },
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-browser-dynamic": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "bcryptjs": "3.0.3",
    "pg": "8.16.3",
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
